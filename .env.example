# Copy to .env and fill in. Never commit real values.

# services/api: HMAC secret for API access tokens (at least 32 random characters).
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
VORTEX_AUTH_SECRET=
VORTEX_API_PORT=8787
# "fixture" (default) serves labeled fixture data until real services are wired in.
VORTEX_SERVICES=fixture
