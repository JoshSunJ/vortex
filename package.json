{
  "name": "vortex",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "dev:api": "npm run dev -w @vortex/api",
    "dev:token": "npm run token -w @vortex/api --"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.15",
    "@rolldown/binding-win32-arm64-msvc": "1.2.15",
    "@rolldown/binding-darwin-arm64": "1.2.15",
    "@rolldown/binding-darwin-x64": "1.2.15",
    "@rolldown/binding-linux-x64-gnu": "1.2.15"
  }
}
